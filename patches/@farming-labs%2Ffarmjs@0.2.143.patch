+function renderFarmDocsCanonicalMeta(config, data, baseUrl) {
+    if (!baseUrl)
+        return "";
+    const href = `${baseUrl.replace(/\/+$/, "")}${data.url.replace(/\/+$/, "")}`;
+    const siteName = config.nav?.title;
+    return [
+        `<link rel="canonical" href="${escapeDocumentText(href)}">`,
+        `<meta property="og:url" content="${escapeDocumentText(href)}">`,
+        `<meta property="og:type" content="article">`,
+        ...(typeof siteName === "string" ? [`<meta property="og:site_name" content="${escapeDocumentText(siteName)}">`] : []),
+    ].join("\n  ");
+}
