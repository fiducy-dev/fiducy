{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".farm",
      ".output",
      ".vercel",
      ".prototype",
      "**/tests/browser/.pages",
      "examples/*/.next",
      "examples/.cli-init-*",
      "packages/cli/tests/.projects",
      "examples/*/.nuxt",
      "examples/*/.svelte-kit",
      "examples/*/.react-router",
      "examples/*/next-env.d.ts",
      "examples/*/src/routeTree.gen.ts",
      "**/farm.d.ts",
      "**/*.generated.ts",
      "packages/sdk/tests/storage/.fiducy_test_*",
      "apps/site/src/components/ui",
      "apps/site/src/lib/utils.ts",
      "apps/site/convex/_generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "none",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDefaultExport": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "include": [
        "apps/*/src/app/**",
        "apps/*/farm.config.ts",
        "apps/*/docs.config.ts",
        "apps/site/convex/schema.ts",
        "apps/site/convex/convex.config.ts",
        "examples/*/app/**",
        "examples/*/src/routes/**",
        "examples/*/server/**",
        "examples/*/*.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
