{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --linker hoisted",
  "buildCommand": "bun run build",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../packages ../../package.json ../../bun.lock ../../bunfig.toml",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
