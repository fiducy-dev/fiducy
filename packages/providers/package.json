{
  "name": "@fiducy/providers",
  "version": "0.3.0-beta.2",
  "description": "Provider adapters for the Fiducy gateway: header swap, path allowlist, redaction and streamed usage",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiducy-dev/fiducy.git",
    "directory": "packages/providers"
  },
  "homepage": "https://fiducy.dev/docs/gateway-api",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --packages external --sourcemap=linked && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fiducy/core": "0.3.0-beta.2"
  },
  "devDependencies": {
    "@fiducy/testing": "0.1.0"
  }
}
