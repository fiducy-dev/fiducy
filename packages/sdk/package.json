{
  "name": "@fiducy/sdk",
  "version": "0.3.0-beta.2",
  "description": "Fiducy app SDK: server instance, framework helpers, database storage, and the <fiducy-key> element with React, Vue, Svelte and Solid wrappers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiducy-dev/fiducy.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://fiducy.dev/docs/server",
  "type": "module",
  "sideEffects": ["./src/element.ts", "./dist/element.js"],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "bun": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react-query": {
      "bun": "./src/reactQuery.ts",
      "types": "./dist/reactQuery.d.ts",
      "default": "./dist/reactQuery.js"
    },
    "./server": {
      "bun": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./element": {
      "bun": "./src/element.ts",
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./vue": {
      "bun": "./src/vue.ts",
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "bun": "./src/svelte.ts",
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./solid": {
      "bun": "./src/solid.ts",
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./next": {
      "bun": "./src/next.ts",
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./tanstack": {
      "bun": "./src/tanstack.ts",
      "types": "./dist/tanstack.d.ts",
      "default": "./dist/tanstack.js"
    },
    "./react-router": {
      "bun": "./src/reactRouter.ts",
      "types": "./dist/reactRouter.d.ts",
      "default": "./dist/reactRouter.js"
    },
    "./sveltekit": {
      "bun": "./src/sveltekit.ts",
      "types": "./dist/sveltekit.d.ts",
      "default": "./dist/sveltekit.js"
    },
    "./nuxt": {
      "bun": "./src/nuxt.ts",
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./node": {
      "bun": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./storage": {
      "bun": "./src/storage/index.ts",
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./storage/kysely": {
      "bun": "./src/storage/kysely/index.ts",
      "types": "./dist/storage/kysely/index.d.ts",
      "default": "./dist/storage/kysely/index.js"
    },
    "./storage/drizzle": {
      "bun": "./src/storage/drizzle/index.ts",
      "types": "./dist/storage/drizzle/index.d.ts",
      "default": "./dist/storage/drizzle/index.js"
    },
    "./storage/prisma": {
      "bun": "./src/storage/prisma/index.ts",
      "types": "./dist/storage/prisma/index.d.ts",
      "default": "./dist/storage/prisma/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/react.ts src/reactQuery.ts src/element.ts src/vue.ts src/svelte.ts src/solid.ts --outdir dist --target browser --packages external --sourcemap=linked && bun build src/index.ts src/server.ts src/next.ts src/tanstack.ts src/reactRouter.ts src/sveltekit.ts src/nuxt.ts src/node.ts src/storage/index.ts src/storage/kysely/index.ts src/storage/drizzle/index.ts src/storage/prisma/index.ts --outdir dist --root src --target node --packages external --sourcemap=linked && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fiducy/core": "0.3.0-beta.2",
    "@fiducy/widget": "0.3.0-beta.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.2",
    "drizzle-orm": "^0.45.0 || >=1.0.0-rc.1 <2.0.0",
    "kysely": "^0.28.17 || ^0.29.0",
    "react": "^19.2.0",
    "vue": "^3.5.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/openai": "4.0.93",
    "@fiducy/testing": "0.1.0",
    "@libsql/client": "0.18.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.104.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "ai": "7.0.139",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "kysely": "0.29.8",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "solid-js": "1.9.18",
    "vue": "3.5.44",
    "zod": "3.25.76"
  }
}
