{
  "name": "@fiducy/assistant-ui",
  "version": "0.3.0-beta.6",
  "description": "Bring-your-own-key for assistant-ui apps with Fiducy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiducy-dev/fiducy.git",
    "directory": "packages/assistant-ui"
  },
  "homepage": "https://github.com/fiducy-dev/fiducy/tree/main/packages/assistant-ui",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "bun": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --packages external --sourcemap=linked && bun build src/server.ts --outdir dist --target node --packages external --sourcemap=linked && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.28",
    "@fiducy/sdk": "^0.3.0-beta.6",
    "ai": "^7.0.139",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.28",
    "@fiducy/sdk": "0.3.0-beta.6",
    "@types/react": "19.2.2",
    "ai": "7.0.139",
    "react": "19.2.7"
  }
}
