{
  "name": "@fiducy/core",
  "version": "0.3.0-beta.5",
  "description": "Crypto core for Fiducy key custody: AES-256-GCM sealed records, split data keys and key handles",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiducy-dev/fiducy.git",
    "directory": "packages/core"
  },
  "homepage": "https://fiducy.dev/docs/how-it-works",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attestation": {
      "bun": "./src/attestation/index.ts",
      "types": "./dist/attestation/index.d.ts",
      "default": "./dist/attestation/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/attestation/index.ts --outdir dist --root src --target node --packages external --sourcemap=linked && tsc -p tsconfig.build.json"
  }
}
