{
  "name": "@fiducy/widget",
  "version": "0.3.0-beta.6",
  "description": "Browser client that mounts the Fiducy key widget iframe",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiducy-dev/fiducy.git",
    "directory": "packages/widget"
  },
  "homepage": "https://fiducy.dev/docs/react",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "bun": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/constants.ts --outdir dist --target browser --packages external --sourcemap=linked && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fiducy/core": "0.3.0-beta.6"
  }
}
